{
  "name": "sobol-dev-wp-theme",
  "version": "1.0",
  "description": "Wordpress theme starter kit.",
  "author": "danilsobolub16b@gmail.com",
  "type": "module",
  "private": true,
  "scripts": {
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "lint:styles": "stylelint \"**/*.{css,scss}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "docker:cli": "docker compose exec back bash",
    "docker:up": "docker compose up",
    "docker:rebuild": "docker compose rm -f && docker compose build",
    "check:uploads": "docker compose exec back bash -c 'wp eval-file --allow-root ./scripts/check-unused-uploads-files.php'",
    "delete:revisions": "docker compose exec back bash -c 'wp revisions clean -1 --allow-root --hard'",
    "deploy:files": "docker compose exec back bash -c 'cd /var/www/html/wp-content/ && zip -r uploads.zip uploads/* && wp --allow-root db export dump.sql && zip dump.zip dump.sql && rm -f dump.sql' && mv wp-content/uploads.zip . && mv wp-content/dump.zip .",
    "dev": "vite",
    "build": "vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "copyfiles": "^2.4.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "gsap": "^3.15.1",
    "handlebars": "^4.7.10",
    "leaflet": "^1.9.4",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "swiper": "^14.4.0",
    "vite": "^8.3.8",
    "vite-plugin-dev-manifest": "^1.5.0",
    "vite-plugin-handlebars": "^2.0.3",
    "vite-plugin-live-reload": "^4.0.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=10.9"
  }
}
